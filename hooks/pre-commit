#!/bin/sh
# lisper: refuse a commit whose staged .lisp files don't boot cleanly.
# Checks the index (what's being committed), not the working tree.
# The core just ran the same check when it passes LISPER_CHECKED_TREE, the
# tree it checked; the check is skipped only if that is exactly what's staged.
[ -n "${LISPER_CHECKED_TREE:-}" ] && [ "$(git write-tree)" = "$LISPER_CHECKED_TREE" ] && exit 0
git diff --cached --name-only | grep -qE '\.lisp$' || exit 0
tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT
git checkout-index -a --prefix="$tmp/"
[ -e .env ] && ln -s "$PWD/.env" "$tmp/.env"
mkdir -p "$tmp/state" "$tmp/.home"
# An empty home: the boot must not touch the live ~/.lisper, and a fresh install must boot.
out=$(cd "$tmp" && LISPER_HOME="$tmp/.home/" LISPING_NO_TUI=1 LISPING_HEADLESS=1 timeout 120 \
      sbcl --noinform --non-interactive --load core.lisp \
      --eval '(lisping-core::print-boot-problems)' 2>&1 | grep '^BOOT-PROBLEMS:')
case "$out" in
  "BOOT-PROBLEMS:NIL") exit 0 ;;
  "") echo "pre-commit: the boot check didn't finish; commit refused." >&2; exit 1 ;;
  *) echo "pre-commit: these files don't boot cleanly; commit refused:" >&2; echo "$out" >&2; exit 1 ;;
esac
